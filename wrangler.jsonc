{
  "name": "elguiacr",
  "compatibility_date": "2026-10-28",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Only the API runs the Worker; every other request is served straight from dist/.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Placeholders: set the real inbox before the first deploy. The sender domain must be verified in Resend.
    "CONTACT_FROM": "El Guía CR <contact@elguiacr.com>",
    "CONTACT_TO": "REPLACE_WITH_INBOX@example.com"
  },
  "previews": {}
}
