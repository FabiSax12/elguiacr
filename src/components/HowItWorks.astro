---
import { getLocale, useTranslations } from '../i18n/utils';
import { getSteps } from '../data/content';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const steps = getSteps(locale);
---

<section id="como-funciona" class="bg-crema-luminoso px-gutter py-seccion">
  <div class="mx-auto max-w-sitio">
    <p class="text-label font-semibold tracking-eyebrow text-verde-principal uppercase">{t.how.eyebrow}</p>
    <h2 class="revelar mt-4 max-w-[820px] font-titulos text-titulo-b font-bold">{t.how.title}</h2>
    <div class="mt-8 h-px bg-mostaza-calido"></div>

    <div class="relative mt-16">
      <svg viewBox="0 0 1000 90" preserveAspectRatio="none" aria-hidden="true" class="absolute top-1 left-0 h-[90px] w-full">
        <polyline class="trazar" pathLength="1" points="0,70 130,44 250,62 380,20 500,40 630,12 760,36 880,8 1000,24" fill="none" stroke="#e0a632" stroke-width="4" vector-effect="non-scaling-stroke"></polyline>
      </svg>
      <ol class="relative grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-x-8 gap-y-10 pt-30">
        {steps.map((step) => (
          <li class="revelar">
            <p class="font-titulos text-[72px]/[1] font-extrabold text-mostaza-calido">{step.number}</p>
            <h3 class="mt-3.5 font-titulos text-2xl/[1.3] font-semibold">{step.title}</h3>
            <p class="mt-2 text-parrafo text-verde-oscuro">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
