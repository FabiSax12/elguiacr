---
import { Image } from 'astro:assets';
import ActBand from './ActBand.astro';
import Footer from './Footer.astro';
import Nav from './Nav.astro';
import farmerPasture from '../assets/farmer-pasture.webp';
import founder from '../assets/founder.jpeg';
import Layout from '../layouts/Layout.astro';
import { getPillars, getSteps } from '../data/content';
import { getContactPath } from '../data/routes';
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const pillars = getPillars(locale);
const steps = getSteps(locale);
const contactHref = getContactPath(locale);
---

<Layout title={t.about.title} description={t.about.description} pageKey="about">
  <div class="font-texto min-w-80 w-full overflow-x-clip bg-crema-luminoso leading-[normal] text-verde-oscuro">
    <Nav pageKey="about" />
    <main>
      <section class="px-gutter pt-seccion-alta pb-seccion">
        <div class="mx-auto w-full max-w-sitio">
          <p class="text-label font-semibold tracking-eyebrow text-verde-principal uppercase">{t.nav.links.about}</p>
          <h1 class="mt-4 max-w-[900px] font-titulos text-titulo-a font-bold">{t.about.heading}</h1>
          <div class="mt-8 h-px max-w-[900px] bg-mostaza-calido"></div>
          <div class="mt-8 flex max-w-[680px] flex-col gap-4 text-lg/[1.6]">
            <p>{t.manifesto.statement}</p>
            <p>{t.manifesto.secondBefore} <span class="font-semibold text-verde-principal italic">{t.manifesto.secondEmphasis}</span> {t.manifesto.secondAfter}</p>
          </div>
        </div>
      </section>

      <section class="bg-arena px-gutter py-seccion" aria-labelledby="fundador-titulo">
        <div class="mx-auto flex w-full max-w-sitio flex-wrap items-center gap-x-16 gap-y-10">
          <figure class="min-w-0 flex-[1_1_380px]">
            <div class="relative aspect-square overflow-clip rounded-imagen bg-verde-principal">
              <Image class="absolute inset-0 block size-full object-cover object-[68%_74%]" src={founder} widths={[500, 1000]} sizes="(min-width: 1000px) 520px, 100vw" alt={t.founder.photoAlt} quality={100} />
            </div>
          </figure>
          <div class="min-w-0 flex-[1_1_460px]">
            <p class="text-label font-semibold tracking-eyebrow text-verde-principal uppercase">{t.founder.role}</p>
            <h2 id="fundador-titulo" class="mt-3 font-titulos text-titulo-b font-bold">{t.founder.name}</h2>
            <p class="mt-2 text-subtitulo text-gris-texto">{t.founder.title}</p>
            <div class="mt-6 flex flex-col gap-4 text-lg/[1.6]">
              <p>{t.founder.bio1}</p>
              <p>{t.founder.bio2}</p>
            </div>
            <blockquote class="mt-8 border-l-4 border-mostaza-calido pl-5">
              <p class="font-titulos text-xl/[1.4] font-medium italic">{t.founder.quote}</p>
            </blockquote>
          </div>
        </div>
      </section>

      <section class="px-gutter py-seccion" aria-labelledby="como-trabajamos">
        <div class="mx-auto w-full max-w-sitio">
          <h2 id="como-trabajamos" class="font-titulos text-titulo-b font-bold">{t.landing.howHeading}</h2>
          <ul class="mt-10 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-6">
            {pillars.map((pillar) => (
              <li class="border-t-2 border-mostaza-calido pt-4">
                <h3 class="font-titulos text-[24px]/[1.15] font-bold">{pillar.title}</h3>
                <p class="mt-3 text-subtitulo/[23px]">{pillar.text}</p>
              </li>
            ))}
          </ul>

          <h3 class="mt-20 max-w-[820px] font-titulos text-[length:clamp(24px,2.3vw,31px)]/[1.2] font-medium italic">{t.how.title}</h3>
          <ol class="mt-10 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-8">
            {steps.map((step) => (
              <li class="border-t-2 border-mostaza-calido pt-4">
                <p class="font-titulos text-[40px]/[1] font-extrabold text-mostaza-calido" aria-hidden="true">{step.number}</p>
                <h4 class="mt-3 font-titulos text-[26px]/[1.1] font-bold">{step.title}</h4>
                <p class="mt-2 text-subtitulo/[23px]">{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="px-gutter pb-seccion">
        <div class="mx-auto flex w-full max-w-sitio flex-wrap items-center gap-9">
          <div class="relative h-[350px] min-w-0 flex-[1_1_460px] overflow-clip rounded-imagen bg-arena">
            <Image class="absolute inset-0 block size-full object-cover" src={farmerPasture} widths={[600, 1200]} sizes="(min-width: 1000px) 620px, 100vw" alt={t.values.photoAlt} />
          </div>
          <div class="min-w-0 flex-[1_1_440px]">
            <h2 class="font-titulos text-[length:clamp(24px,2.3vw,31px)]/[1.2] font-medium italic">{t.values.headline}</h2>
            <div class="mt-8 flex overflow-clip rounded-tarjeta bg-arena">
              <span class="shrink-0 grow-0 basis-barra bg-mostaza-calido" aria-hidden="true"></span>
              <div class="p-bloque text-parrafo">
                <p>{t.values.text}</p>
                <p class="mt-4"><strong class="block font-semibold text-verde-oscuro">{t.values.closingLead}</strong>{t.values.closingText}</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <ActBand contactHref={contactHref} />
    <Footer />
  </div>
</Layout>
