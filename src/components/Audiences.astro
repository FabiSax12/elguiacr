---
import Leaves from './Leaves.astro';
import { audiences } from '../data/audiences';
---

<section id="para-quien" class="oscuro" style="position: relative; background: #17362d; color: #fff7e8; overflow: clip; padding: clamp(96px, 12vw, 168px) clamp(16px, 5vw, 64px) clamp(80px, 10vw, 128px);">
  <Leaves backFill="#667d63" backVein="#17362d" backInset="4%" backTop="40px" backWidth="40%" frontFill="#1f5c46" frontVein="#e0a632" sideVeinOpacity=".6" />

  <div style="position: relative; max-width: 1240px; margin: 0 auto;">
    <div style="text-align: center; max-width: 760px; margin: 0 auto;">
      <p style="margin: 0; font: 600 12px/17px 'Source Sans 3', system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase; color: #e0a632;">02 · Para quién</p>
      <h2 style="margin: 16px 0 0; font: 700 clamp(38px, 5vw, 68px)/1.04 'Alegreya', Georgia, serif;">Una marca, cuatro puertas de entrada.</h2>
      <p style="margin: 20px auto 0; max-width: 560px; font: 400 18px/1.6 'Source Sans 3', system-ui, sans-serif;">Lo que cambia es el objetivo. La forma de trabajar es la misma: escuchar, diseñar, coordinar.</p>
    </div>

    <div style="margin-top: 72px; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
      {audiences.map((audience) => (
        <a class="tarjeta-area" href="#contanos" data-segment={audience.segment} style="display: flex; flex-direction: column; text-decoration: none; color: #17362d; background: #fff7e8;">
          <div style={`height: 230px; background: ${audience.photoBg}; position: relative; overflow: clip; display: flex; align-items: flex-end; padding: 14px;`}><p style={`margin: 0; font: 400 13px/19px 'Source Sans 3', system-ui, sans-serif; color: ${audience.photoNoteColor};`}>{audience.photoNote}</p></div>
          <div style={`background: ${audience.headBg}; color: ${audience.headColor}; padding: 4px 22px 20px; border-top: 1px solid ${audience.headBorder};`}>
            <p style={`margin: 14px 0 0; font: ${audience.segmentWeight} 12px/17px 'Source Sans 3', system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase;`}>{audience.segment}</p>
            <p style={`margin: 4px 0 0; font: 700 44px/1 'Alegreya', Georgia, serif; color: ${audience.wordColor};`}>{audience.word}</p>
          </div>
          <div style="padding: 20px 22px 24px; flex-grow: 1; display: flex; flex-direction: column; gap: 16px;">
            <p style="margin: 0; font: 400 15px/23px 'Source Sans 3', system-ui, sans-serif;">{audience.description}</p>
            <span style="margin-top: auto; font: 600 15px/24px 'Source Sans 3', system-ui, sans-serif; color: #1f5c46;">{audience.cta} <span class="flecha" aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
