---
import { getLocale, useTranslations } from '../i18n/utils';
import { getAudiences } from '../data/audiences';
import { landingPageKeyByAudience } from '../data/landings';
import { getPagePath } from '../data/routes';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const audiences = getAudiences(locale);
---

<section id="para-quien" class="flex min-h-svh flex-col justify-center oscuro relative overflow-clip bg-verde-oscuro px-gutter pt-seccion-alta pb-seccion-cierre text-crema-luminoso">
  <div class="relative mx-auto w-full max-w-sitio">
    <div class="mx-auto w-full max-w-[760px] text-center">
      <p class="text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase">{t.audiences.eyebrow}</p>
      <h2 class="mt-4 font-titulos text-titulo-a font-bold">{t.audiences.title}</h2>
      <p class="mx-auto mt-5 max-w-[560px] text-lg/[1.6]">{t.audiences.intro}</p>
    </div>

    <div class="mt-18 grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-5">
      {audiences.map((audience) => (
        <div class="group relative flex flex-col overflow-clip rounded-tarjeta bg-crema-luminoso text-verde-oscuro transition-transform duration-500 ease-[cubic-bezier(.2,.7,.2,1)] hover:-translate-y-2">
          <div class:list={['relative flex h-[155px] items-end overflow-clip p-3.5', audience.photoBg]}><p class:list={['text-nota', audience.photoNoteColor]}>{audience.photoNote}</p></div>
          <div class:list={['border-t px-[22px] pt-1 pb-5', audience.headBg, audience.headColor, audience.headBorder]}>
            <p class:list={['mt-3.5 text-label tracking-eyebrow uppercase', audience.segmentWeight]}>{audience.segment}</p>
            <p class:list={['mt-1 font-titulos text-[30px]/[1] font-bold', audience.wordColor]}>{audience.word}</p>
          </div>
          <div class="flex grow flex-col gap-4 px-[22px] pt-5 pb-6">
            <p class="text-subtitulo/[23px]">{audience.description}</p>
            <a class="mt-auto text-subtitulo font-semibold text-verde-principal no-underline after:absolute after:inset-0 after:content-['']" href="#contanos" data-segment={audience.id}>{audience.cta} <span class="inline-block transition-transform duration-300 ease-[ease] group-hover:translate-x-1.5" aria-hidden="true">→</span></a>
            <a class="relative z-10 self-start text-cuerpo font-semibold text-verde-oscuro underline underline-offset-4 hover:text-verde-principal" href={getPagePath(landingPageKeyByAudience[audience.id], locale)}>{t.audiences.learnMore}<span class="sr-only"> · {audience.segment}</span></a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
