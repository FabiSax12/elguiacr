---
import { getLocale, useTranslations } from '../i18n/utils';
import logo from '../assets/logo.svg';
import { navLinks } from '../data/content';
import { landingPageKeys, getPagePath, instagramUrl, legalPageKeys } from '../data/routes';
import { contactEmail } from '../data/site';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const navLink = 'inline-block py-1.5 text-crema-luminoso no-underline hover:text-mostaza-calido';
---

<footer class="oscuro bg-verde-oscuro px-gutter pt-12 pb-8 text-crema-luminoso">
  <div class="mx-auto w-full max-w-sitio">
    <div class="flex flex-wrap justify-between gap-10">
      <div class="max-w-[360px]">
        <img src={logo.src} alt="El Guía CR" width={logo.width} height={logo.height} class="block h-auto w-[200px]" loading="lazy" decoding="async" />
        <p class="mt-6 font-titulos text-[22px]/[1.35] font-medium text-mostaza-calido italic">{t.footer.tagline}</p>
      </div>
      <div class="flex flex-wrap gap-12">
        <div>
          <p class="mb-3 text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase">{t.footer.exploreHeading}</p>
          <ul class="flex flex-col gap-1 text-subtitulo">
            {navLinks.map((key) => (
              <li><a class={navLink} href={getPagePath(key, locale)}>{t.nav.links[key]}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="mb-3 text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase">{t.footer.servicesHeading}</p>
          <ul class="flex flex-col gap-1 text-subtitulo">
            {landingPageKeys.map((key) => (
              <li><a class={navLink} href={getPagePath(key, locale)}>{t.footer.servicesLinks[key]}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="mb-3 text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase">{t.footer.legalHeading}</p>
          <ul class="flex flex-col gap-1 text-subtitulo">
            {legalPageKeys.map((key) => (
              <li><a class={navLink} href={getPagePath(key, locale)}>{t.footer.legalLinks[key]}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="mb-3 text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase">{t.footer.contactHeading}</p>
          <ul class="flex flex-col gap-2.5 text-subtitulo">
            <li>WhatsApp +506 8587 8863</li>
            <li>{contactEmail}</li>
            <li><a class={navLink} href={instagramUrl} rel="noopener" target="_blank">{t.footer.instagramLabel}</a></li>
            <li>Alajuela, Costa Rica</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-14 flex flex-wrap justify-between gap-3 border-t border-mostaza-calido/40 pt-5 text-eyebrow font-semibold tracking-eyebrow-sm uppercase">
      <span>© 2026 El Guía CR · elguiacr.com</span>
      <span>{t.footer.madeIn}</span>
    </div>
  </div>
</footer>
