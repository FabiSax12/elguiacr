---
import { getLocale } from '../i18n/utils';
import { getAudiences } from '../data/audiences';

const locale = getLocale(Astro.currentLocale);
const tickerWords = getAudiences(locale).map((audience) => audience.word);
const items = Array.from({ length: 4 }, () => tickerWords.flatMap((word) => [word, '·'])).flat();
---

<div aria-hidden="true" class="overflow-clip bg-mostaza-calido py-[18px] text-verde-oscuro">
  <div class="flex w-max animate-cinta gap-12 font-titulos text-[36px]/[1] font-semibold whitespace-nowrap italic">
    {items.map((item) => <span>{item}</span>)}
  </div>
</div>
