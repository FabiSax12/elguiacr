---
import { getLocale, useTranslations } from '../i18n/utils';
import { getSegments } from '../data/audiences';
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const segments = getSegments(locale);

const label = 'text-subtitulo font-semibold';
const campo = 'w-full rounded-none border-0 border-b-2 border-b-verde-oscuro bg-transparent py-2.5 text-entrada text-verde-oscuro placeholder:text-gris-texto focus:border-b-verde-principal focus:bg-arena';
const textarea = `${campo} min-h-24 resize-y`;
const textareaShort = `${campo} min-h-[72px] resize-y`;
---

<section id="contanos" class="bg-crema-luminoso px-gutter pb-[clamp(80px,10vw,144px)]">
  <div class="mx-auto flex max-w-sitio flex-wrap items-stretch">
    <div class="oscuro relative min-w-0 flex-[1_1_400px] overflow-clip bg-verde-principal p-[clamp(32px,4vw,56px)] text-crema-luminoso">
      <p class="text-label font-semibold tracking-eyebrow text-crema-luminoso uppercase">{t.contact.eyebrow}</p>
      <h2 class="mt-4 font-titulos text-[length:clamp(36px,4vw,56px)]/[1.05] font-bold">{t.contact.title}</h2>
      <p class="mt-5 text-entrada/[1.6]">{t.contact.intro}</p>
      <ol class="mt-10 flex flex-col gap-[22px]">
        {[0, 1, 2].map((index) => (
          <li class="flex gap-4"><span class="font-titulos text-[28px]/[1] font-bold text-mostaza-calido" aria-hidden="true">{index + 1}</span><span class="text-base/[1.5]"><strong class="font-semibold">{t.contact.steps[index].lead}</strong> {t.contact.steps[index].rest}</span></li>
        ))}
      </ol>
      <svg viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true" class="absolute bottom-6 left-0 h-[60px] w-full"><polyline points="0,52 70,30 130,42 200,12 260,26 330,6 400,16" fill="none" stroke="#e0a632" stroke-width="3" vector-effect="non-scaling-stroke"></polyline></svg>
    </div>

    <div class="min-w-0 flex-[1.4_1_480px] border-2 border-verde-oscuro bg-white p-[clamp(28px,4vw,56px)]">
      <div data-form-view="form" class="flex flex-col gap-7">
        <fieldset>
          <legend class="text-subtitulo font-semibold">{t.contact.whoFor}</legend>
          <div class="mt-3 flex flex-wrap gap-2.5">
            {segments.map((segment) => (
              <button type="button" class="group min-h-11 cursor-pointer border-2 border-verde-oscuro bg-transparent px-[18px] text-subtitulo font-semibold text-verde-oscuro not-aria-pressed:hover:bg-verde-oscuro not-aria-pressed:hover:text-crema-luminoso aria-pressed:border-verde-principal aria-pressed:bg-verde-principal aria-pressed:text-crema-luminoso" data-chip={segment.id} aria-pressed="false"><span class="hidden group-aria-pressed:inline">✓ </span>{segment.label}</button>
            ))}
          </div>
        </fieldset>

        <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-6">
          <div><label for="f-nombre" class={label}>{t.contact.nameLabel}</label><input id="f-nombre" class={campo} type="text" autocomplete="name" placeholder={t.contact.namePlaceholder}></div>
          <div><label for="f-contacto" class={label}>{t.contact.contactLabel}</label><input id="f-contacto" class={campo} type="text" autocomplete="email" placeholder={t.contact.contactPlaceholder}></div>
        </div>

        <div><label for="f-que" class={label}>{t.contact.whatLabel}</label><textarea id="f-que" class={textarea} placeholder={t.contact.whatPlaceholder}></textarea></div>

        <div data-field="destination-row" hidden class="flex flex-wrap items-center gap-3 bg-arena px-4 py-3">
          <span class="text-sm font-medium">{t.contact.destinationPicked} <strong data-field="destination-name" class="font-semibold"></strong></span>
          <button type="button" data-clear-destination class="min-h-9 cursor-pointer border-0 bg-transparent px-3 text-sm font-semibold text-verde-principal underline">{t.contact.destinationRemove}</button>
        </div>

        <div class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-6">
          <div><label for="f-personas" class={label}>{t.contact.peopleLabel}</label><input id="f-personas" class={campo} type="number" min="1" inputmode="numeric" placeholder={t.contact.peoplePlaceholder}></div>
          <div><label for="f-fecha" class={label}>{t.contact.dateLabel}</label><input id="f-fecha" class={campo} type="text" placeholder={t.contact.datePlaceholder}></div>
        </div>

        <div><label for="f-extra" class={label}>{t.contact.extraLabel} <span class="font-normal text-gris-texto">{t.contact.optional}</span></label><textarea id="f-extra" class={textareaShort} placeholder={t.contact.extraPlaceholder}></textarea></div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <button type="button" class="inline-flex min-h-13 cursor-pointer items-center gap-2.5 border-0 bg-verde-principal px-7 text-base font-semibold text-crema-luminoso hover:bg-verde-oscuro" data-submit>{t.contact.submit} <span class="inline-block" aria-hidden="true">→</span></button>
          <p class="text-nota text-gris-texto">{t.contact.privacy} <a class="underline" href="#privacidad">{t.contact.privacyLink}</a></p>
        </div>
      </div>

      <div data-form-view="sent" hidden class="flex min-h-[520px] flex-col justify-center gap-[18px]">
        <svg viewBox="0 0 300 60" aria-hidden="true" class="h-11 w-[220px]"><polyline class="dibujar" pathLength="1" points="0,50 60,30 110,40 165,12 215,24 270,4 300,10" fill="none" stroke="#e0a632" stroke-width="4"></polyline></svg>
        <h3 class="font-titulos text-[44px]/[1.05] font-bold">{t.contact.sentTitle}</h3>
        <p class="max-w-[460px] text-entrada/[1.6]">{t.contact.sentText}</p>
        <button type="button" data-reset class="min-h-11 cursor-pointer self-start border-0 bg-transparent p-0 text-subtitulo font-semibold text-verde-principal underline">{t.contact.sentReset}</button>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('contanos');

  if (section) {
    const views = section.querySelectorAll<HTMLElement>('[data-form-view]');
    const chips = section.querySelectorAll<HTMLButtonElement>('[data-chip]');
    const destinationRow = section.querySelector<HTMLElement>('[data-field="destination-row"]');
    const destinationName = section.querySelector<HTMLElement>('[data-field="destination-name"]');
    const fields = section.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea');

    let segment: string | null = null;
    let destination: string | null = null;
    let sent = false;

    const render = () => {
      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.chip === segment)));
      if (destinationRow && destinationName) {
        destinationRow.hidden = !destination;
        destinationName.textContent = destination ?? '';
      }
      views.forEach((view) => {
        view.hidden = (view.dataset.formView === 'sent') !== sent;
      });
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        segment = segment === chip.dataset.chip ? null : (chip.dataset.chip ?? null);
        render();
      });
    });

    document.querySelectorAll<HTMLElement>('[data-segment]').forEach((card) => {
      card.addEventListener('click', () => {
        segment = card.dataset.segment ?? null;
        render();
      });
    });

    document.addEventListener('destination-picked', (event) => {
      destination = (event as CustomEvent<{ name: string }>).detail.name;
      render();
    });

    section.querySelector('[data-clear-destination]')?.addEventListener('click', () => {
      destination = null;
      render();
    });

    section.querySelector('[data-submit]')?.addEventListener('click', () => {
      sent = true;
      render();
    });

    section.querySelector('[data-reset]')?.addEventListener('click', () => {
      sent = false;
      segment = null;
      destination = null;
      fields.forEach((field) => {
        field.value = '';
      });
      render();
    });
  }
</script>
