---
import { getWhatsappUrl } from '../data/routes';
import { getLocale, useTranslations } from '../i18n/utils';

interface Props {
  // Pre-filled text of the chat; the page decides what fits it.
  message: string;
}

const { message } = Astro.props;
const t = useTranslations(getLocale(Astro.currentLocale));
---

<a
  href={getWhatsappUrl(message)}
  rel="noopener"
  target="_blank"
  aria-label={t.act.whatsappCta}
  data-whatsapp-float
  class="fixed right-4 bottom-4 z-40 inline-flex size-14 items-center justify-center rounded-full border-2 border-crema-luminoso bg-verde-principal text-crema-luminoso no-underline shadow-[0_8px_20px_-6px_rgb(0_0_0/0.5)] hover:bg-verde-oscuro hover:text-crema-luminoso focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-mostaza-calido motion-safe:transition-opacity motion-safe:duration-200 inert:pointer-events-none inert:opacity-0 sm:right-6 sm:bottom-6"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="size-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
    <path transform="translate(7.2 7.2) scale(0.4)" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" stroke-width="3.6"></path>
  </svg>
</a>

<script>
  // The contact form has its own WhatsApp option, so the button steps aside while the form is on screen.
  const button = document.querySelector<HTMLElement>('[data-whatsapp-float]');
  const form = document.getElementById('contanos');

  if (button && form) {
    new IntersectionObserver((entries) => {
      const hidden = entries.some((entry) => entry.isIntersecting);
      if (hidden) button.blur();
      button.toggleAttribute('inert', hidden);
    }).observe(form);
  }
</script>
