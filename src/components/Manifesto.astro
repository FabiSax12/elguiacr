---
import { getLocale, useTranslations } from '../i18n/utils';
import { getPillars } from '../data/content';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const pillars = getPillars(locale);
---

<section class="bg-crema-luminoso px-gutter py-seccion">
  <div class="mx-auto flex max-w-sitio flex-wrap items-start gap-x-16 gap-y-12">
    <p class="shrink-0 grow-0 basis-auto text-label font-semibold tracking-eyebrow text-verde-principal uppercase">{t.manifesto.eyebrow}</p>
    <div class="min-w-0 flex-[1_1_640px]">
      <p class="revelar font-titulos text-[length:clamp(30px,3.8vw,54px)]/[1.18] font-semibold text-verde-oscuro">{t.manifesto.statementBefore} <span class="text-verde-principal italic">{t.manifesto.statementEmphasis}</span> {t.manifesto.statementAfter}</p>
      <div class="mt-14 h-px bg-mostaza-calido"></div>
      <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(170px,1fr))] gap-6">
        {pillars.map((pillar) => (
          <div><p class="font-titulos text-[36px]/[1] font-bold text-mostaza-calido" aria-hidden="true">{pillar.symbol}</p><p class="mt-2.5 text-subtitulo font-semibold">{pillar.title}</p><p class="mt-1 text-cuerpo text-gris-texto">{pillar.text}</p></div>
        ))}
      </div>
    </div>
  </div>
</section>
