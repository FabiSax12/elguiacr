---
import { Image } from 'astro:assets';
import { getLocale, useTranslations } from '../i18n/utils';
import { getStories } from '../data/content';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const stories = getStories(locale);

const kicker = 'block text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase';
const storyTitle = 'mt-1 block font-titulos text-xl/[1.3] font-semibold';
---

<section id="historias" class="oscuro bg-verde-oscuro min-h-svh pt-seccion pb-[clamp(40px,5.3vw,75px)] text-crema-luminoso">
  <div class="mx-auto flex max-w-sitio flex-wrap items-end justify-between gap-6 px-gutter">
    <div class="max-w-[680px]">
      <p class="text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase">{t.stories.eyebrow}</p>
      <h2 class="mt-4 font-titulos text-titulo-b font-bold">{t.stories.title}</h2>
    </div>
    <p class="max-w-[380px] text-base/[1.6]">{t.stories.intro}</p>
  </div>

  <div class="mt-9 scroll-timeline:h-[2600px] scroll-timeline:[view-timeline-name:--horiz]">
    <div class="scroll-timeline:sticky scroll-timeline:top-6">
      <div class="snap-x snap-mandatory overflow-x-auto [-webkit-overflow-scrolling:touch] scroll-timeline:overflow-x-clip" role="region" aria-label={t.stories.regionLabel} tabindex="0">
        <div class="horiz-pista flex w-max gap-5 px-gutter pb-2 *:snap-start">
          {stories.map((story) => story.format === 'reel' ? (
            <figure class="w-[300px] flex-none">
              <div class:list={['flex aspect-[9/16] flex-col justify-between rounded-imagen p-[18px]', story.background]}>
                <span class="inline-flex size-13 items-center justify-center rounded-full border-2 border-crema-luminoso" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 16 16"><path d="M4 2.5 L13 8 L4 13.5 Z" fill="#fff7e8"></path></svg></span>
                <p class="text-nota">{story.note}</p>
              </div>
              <figcaption class="mt-3.5"><span class={kicker}>{story.kicker}</span><span class={storyTitle}>{story.title}</span></figcaption>
            </figure>
          ) : (
            <figure class="w-[520px] flex-none self-center">
              <div class:list={['relative flex aspect-[4/3] flex-col justify-end overflow-clip rounded-imagen p-[18px]', story.background, story.color]}>
                {story.image ? (
                  <Image class="absolute inset-0 block size-full object-cover" src={story.image} widths={[520, 1040]} sizes="520px" alt={story.alt ?? ''} />
                ) : (
                  <p class="text-nota">{story.note}</p>
                )}
              </div>
              <figcaption class="mt-3.5"><span class={kicker}>{story.kicker}</span><span class={storyTitle}>{story.title}</span></figcaption>
            </figure>
          ))}
          <a href="#contanos" class="flex aspect-square w-[320px] flex-none flex-col justify-between self-center rounded-tarjeta bg-mostaza-calido p-7 text-verde-oscuro no-underline hover:bg-crema-luminoso hover:text-verde-oscuro">
            <span class="font-titulos text-4xl/[1.1] font-bold">{t.stories.closingTitle}</span>
            <span class="text-base font-semibold">{t.stories.closingCta} <span class="inline-block" aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
      <div class="mx-auto mt-7 max-w-sitio px-gutter">
        <div class="h-1 bg-crema-luminoso/15"><div class="horiz-barra h-1 origin-left bg-mostaza-calido"></div></div>
      </div>
    </div>
  </div>
</section>
