---
import { stories } from '../data/content';
---

<section id="historias" class="oscuro" style="background: #17362d; color: #fff7e8; padding: clamp(80px, 10vw, 144px) 0 clamp(64px, 8vw, 112px);">
  <div style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px;">
    <div style="max-width: 680px;">
      <p style="margin: 0; font: 600 12px/17px 'Source Sans 3', system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase; color: #e0a632;">05 · Historias</p>
      <h2 style="margin: 16px 0 0; font: 700 clamp(36px, 4.6vw, 64px)/1.05 'Alegreya', Georgia, serif;">Mejor verlo que contarlo.</h2>
    </div>
    <p style="margin: 0; max-width: 380px; font: 400 16px/1.6 'Source Sans 3', system-ui, sans-serif;">Siga bajando: las historias pasan de lado. Experiencias reales, aliados y el detrás de cámaras.</p>
  </div>

  <div class="horiz-outer" style="margin-top: 56px;">
    <div class="horiz-sticky">
      <div class="horiz-vista" role="region" aria-label="Historias en video" tabindex="0">
        <div class="horiz-track">
          {stories.map((story) => story.format === 'reel' ? (
            <figure style="margin: 0; width: 300px; flex: 0 0 auto;">
              <div style={`aspect-ratio: 9 / 16; background: ${story.background}; padding: 18px; display: flex; flex-direction: column; justify-content: space-between;`}>
                <span style="width: 52px; height: 52px; border: 2px solid #fff7e8; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 16 16"><path d="M4 2.5 L13 8 L4 13.5 Z" fill="#fff7e8"></path></svg></span>
                <p style="margin: 0; font: 400 13px/19px 'Source Sans 3', system-ui, sans-serif;">{story.note}</p>
              </div>
              <figcaption style="margin-top: 14px;"><span style="display: block; font: 600 12px/17px 'Source Sans 3', system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase; color: #e0a632;">{story.kicker}</span><span style="display: block; margin-top: 4px; font: 600 20px/1.3 'Alegreya', Georgia, serif;">{story.title}</span></figcaption>
            </figure>
          ) : (
            <figure style="margin: 0; width: 520px; flex: 0 0 auto; align-self: center;">
              <div style={`aspect-ratio: 4 / 3; background: ${story.background}; color: ${story.color}; padding: 18px; display: flex; flex-direction: column; justify-content: flex-end;`}>
                <p style="margin: 0; font: 400 13px/19px 'Source Sans 3', system-ui, sans-serif;">{story.note}</p>
              </div>
              <figcaption style="margin-top: 14px;"><span style="display: block; font: 600 12px/17px 'Source Sans 3', system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase; color: #e0a632;">{story.kicker}</span><span style="display: block; margin-top: 4px; font: 600 20px/1.3 'Alegreya', Georgia, serif;">{story.title}</span></figcaption>
            </figure>
          ))}
          <a href="#contanos" class="btn-claro" style="width: 320px; flex: 0 0 auto; align-self: center; aspect-ratio: 1 / 1; background: #e0a632; color: #17362d; text-decoration: none; padding: 28px; display: flex; flex-direction: column; justify-content: space-between;">
            <span style="font: 700 36px/1.1 'Alegreya', Georgia, serif;">¿La próxima historia es la suya?</span>
            <span style="font: 600 16px/24px 'Source Sans 3', system-ui, sans-serif;">Cuéntenos qué tiene en mente <span class="flecha" aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
      <div style="max-width: 1240px; margin: 28px auto 0; padding: 0 clamp(16px, 5vw, 64px);">
        <div style="height: 4px; background: rgba(255,247,232,.15);"><div class="horiz-barra" style="height: 4px; background: #e0a632; transform-origin: 0 50%;"></div></div>
      </div>
    </div>
  </div>
</section>
