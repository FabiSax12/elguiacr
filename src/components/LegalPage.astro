---
import Footer from './Footer.astro';
import LegalInline from './LegalInline.astro';
import Nav from './Nav.astro';
import Layout from '../layouts/Layout.astro';
import type { LegalLink, LegalSection } from '../data/legal';
import type { PageKey } from '../data/routes';
import { localeMeta } from '../i18n/config';
import { getLocale, useTranslations } from '../i18n/utils';

interface Props {
  pageKey: PageKey;
  title: string;
  description: string;
  heading: string;
  intro: string;
  updatedLabel: string;
  // ISO date of the text; shown as a long date and used as the <time> value.
  updated: string;
  tocLabel: string;
  tocId: string;
  sections: LegalSection[];
  // Targets of the `{token}` markers used in the section text.
  links: Record<string, LegalLink>;
}

const { pageKey, title, description, heading, intro, updatedLabel, updated, tocLabel, tocId, sections, links } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Constructed as UTC midnight, so format in UTC to keep the day the same in every timezone.
const updatedText = new Intl.DateTimeFormat(localeMeta[locale].ogLocale.replace('_', '-'), { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(updated));
---

<Layout title={title} description={description} pageKey={pageKey}>
  <div class="font-texto min-w-80 w-full overflow-x-clip bg-crema-luminoso leading-[normal] text-verde-oscuro">
    <Nav pageKey={pageKey} />
    <main class="px-gutter pt-seccion-alta pb-seccion">
      <div class="mx-auto w-full max-w-sitio">
        <p class="text-label font-semibold tracking-eyebrow text-verde-principal uppercase">{t.footer.legalHeading}</p>
        <h1 class="mt-4 max-w-[820px] font-titulos text-titulo-a font-bold">{heading}</h1>
        <div class="mt-8 h-px max-w-[820px] bg-mostaza-calido"></div>
        <p class="mt-8 max-w-[680px] text-lg/[1.6]">{intro}</p>
        <p class="mt-4 max-w-[680px] text-cuerpo text-gris-texto">{updatedLabel}: <time datetime={updated}>{updatedText}</time></p>

        <nav aria-labelledby={tocId} class="mt-10 max-w-[680px]">
          <p id={tocId} class="text-label font-semibold tracking-eyebrow text-verde-principal uppercase">{tocLabel}</p>
          <ol class="mt-3 flex list-decimal flex-col gap-1 pl-6 text-subtitulo marker:text-gris-texto">
            {sections.map((section) => (
              <li><a class="underline" href={`#${section.id}`}>{section.heading}</a></li>
            ))}
          </ol>
        </nav>

        <div class="mt-14 flex max-w-[680px] flex-col gap-12">
          {sections.map((section) => (
            <section id={section.id} aria-labelledby={`${section.id}-titulo`}>
              <h2 id={`${section.id}-titulo`} class="font-titulos text-[26px]/[1.15] font-bold">{section.heading}</h2>
              <div class="mt-4 flex flex-col gap-4 text-base/[1.65]">
                {section.blocks.map((block) => {
                  if ('p' in block) return <p><LegalInline text={block.p} links={links} /></p>;
                  if ('list' in block) {
                    return (
                      <ul class="flex list-disc flex-col gap-2 pl-6 marker:text-mostaza-sombra">
                        {block.list.map((item) => (
                          <li><LegalInline text={item} links={links} /></li>
                        ))}
                      </ul>
                    );
                  }
                  if ('facts' in block) {
                    return (
                      <dl class="grid grid-cols-1 gap-x-6 gap-y-1 sm:grid-cols-[max-content_1fr]">
                        {block.facts.map((fact) => (
                          <>
                            <dt class="font-semibold">{fact.label}</dt>
                            <dd class="mb-2 last:mb-0 sm:mb-0"><LegalInline text={fact.value} links={links} /></dd>
                          </>
                        ))}
                      </dl>
                    );
                  }
                  if (!('table' in block)) throw new Error(`Unknown legal block in section "${section.id}"`);
                  return (
                    <div class="overflow-x-auto" role="region" tabindex="0" aria-label={block.table.head[0]}>
                      <table class="w-full min-w-[560px] border-collapse text-left text-cuerpo/[1.5]">
                        <thead>
                          <tr class="border-b-2 border-mostaza-calido">
                            {block.table.head.map((cell) => <th scope="col" class="py-2 pr-4 font-semibold">{cell}</th>)}
                          </tr>
                        </thead>
                        <tbody>
                          {block.table.rows.map(([name, ...cells]) => (
                            <tr class="border-b border-verde-oscuro/20 align-top">
                              <th scope="row" class="py-3 pr-4 font-semibold">{name}</th>
                              {cells.map((cell) => <td class="py-3 pr-4"><LegalInline text={cell} links={links} /></td>)}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
