---
import { getLocale, useTranslations } from '../i18n/utils';

const t = useTranslations(getLocale(Astro.currentLocale));
---
<section id="inicio" class="oscuro relative overflow-clip bg-verde-oscuro text-crema-luminoso">
  <div class="mx-auto flex max-w-sitio flex-wrap items-center gap-14 px-gutter pt-hero pb-35">
    <div class="relative z-[2] min-w-0 flex-[1_1_520px]">
      <p class="mb-6 text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase">{t.hero.eyebrow}</p>
      <h1 class="font-titulos text-hero font-extrabold tracking-[-0.02em]">{t.hero.titleBefore} <em class="font-semibold text-mostaza-calido italic">{t.hero.titleEmphasis}</em></h1>
      <p class="mt-8 max-w-[520px] text-[length:clamp(18px,1.6vw,21px)]/[1.55] text-crema-luminoso">{t.hero.intro}</p>
      <div class="mt-10 flex flex-wrap gap-3.5">
        <a class="inline-flex min-h-13 items-center gap-2.5 bg-mostaza-calido px-7 text-base font-semibold text-verde-oscuro no-underline hover:bg-crema-luminoso hover:text-verde-oscuro" href="#contanos">{t.hero.primaryCta} <span class="inline-block" aria-hidden="true">→</span></a>
        <a class="inline-flex min-h-13 items-center border-2 border-crema-luminoso px-6 text-base font-semibold text-crema-luminoso no-underline hover:bg-crema-luminoso hover:text-verde-oscuro" href="#como-funciona">{t.hero.secondaryCta}</a>
      </div>
      <p class="mt-10 text-dato font-medium text-crema-luminoso opacity-85">{t.hero.segments}</p>
    </div>

    <!-- parallax collage -->
    <div class="relative h-[620px] min-w-0 flex-[1_1_420px]">
      <div class="parallax-a absolute top-0 right-0 flex h-[560px] w-[74%] flex-col justify-end overflow-clip bg-verde-principal p-[22px]">
        <svg viewBox="0 0 300 80" preserveAspectRatio="none" aria-hidden="true" class="absolute top-[38%] left-0 h-20 w-full opacity-50"><polyline points="0,70 60,48 110,58 165,26 215,40 270,10 300,18" fill="none" stroke="#e0a632" stroke-width="3" vector-effect="non-scaling-stroke"></polyline></svg>
        <div class="absolute top-[22px] left-[22px] flex items-center gap-2.5 text-eyebrow font-semibold tracking-eyebrow-sm text-crema-luminoso uppercase">
          <span class="inline-flex size-11 items-center justify-center rounded-full border-2 border-crema-luminoso"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5 L13 8 L4 13.5 Z" fill="#fff7e8"></path></svg></span>
          {t.hero.videoLabel}
        </div>
        <p class="relative text-cuerpo text-crema-luminoso">{t.hero.videoNote}</p>
      </div>
      <div class="parallax-b absolute top-[300px] left-0 flex h-[250px] w-[44%] flex-col justify-end border-[6px] border-verde-oscuro bg-arena p-4 text-verde-oscuro">
        <p class="mb-1.5 text-eyebrow font-semibold tracking-eyebrow-sm text-verde-principal uppercase">{t.hero.photoLabel}</p>
        <p class="text-nota">{t.hero.photoNoteMain}</p>
      </div>
      <div class="parallax-c absolute top-10 left-[12%] flex h-[190px] w-[34%] flex-col justify-end border-[6px] border-verde-oscuro bg-mostaza-calido p-3.5 text-verde-oscuro">
        <p class="mb-1.5 text-eyebrow font-semibold tracking-eyebrow-sm uppercase">{t.hero.photoLabel}</p>
        <p class="text-nota">{t.hero.photoNoteSecondary}</p>
      </div>
    </div>
  </div>

  <!-- the path draws itself -->
  <svg viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true" class="absolute bottom-[18px] left-0 h-[120px] w-full">
    <polyline class="dibujar" pathLength="1" points="0,104 180,70 340,88 520,34 700,60 880,22 1060,50 1240,8 1440,30" fill="none" stroke="#e0a632" stroke-width="4" vector-effect="non-scaling-stroke"></polyline>
  </svg>
</section>
