---
import { getLocale, useTranslations } from '../i18n/utils';

const t = useTranslations(getLocale(Astro.currentLocale));
---
<section id="inicio" class="oscuro relative flex min-h-svh flex-col justify-center overflow-clip bg-verde-oscuro text-crema-luminoso">
  <div class="mx-auto flex w-full max-w-sitio flex-wrap items-center gap-9 px-gutter pt-hero pb-24">
    <div class="relative z-[2] min-w-0 flex-[1_1_380px]">
      <p class="mb-4 text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase">{t.hero.eyebrow}</p>
      <h1 class="font-titulos text-hero font-extrabold tracking-[-0.02em]">{t.hero.titleBefore} <em class="font-semibold text-mostaza-calido italic">{t.hero.titleEmphasis}</em></h1>
      <p class="mt-5 max-w-[420px] text-[length:clamp(15px,1.1vw,17px)]/[1.55] text-crema-luminoso">{t.hero.intro}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="inline-flex min-h-11 items-center gap-2.5 bg-mostaza-calido px-7 text-base font-semibold text-verde-oscuro no-underline hover:bg-crema-luminoso hover:text-verde-oscuro" href="#contanos">{t.hero.primaryCta} <span class="inline-block" aria-hidden="true">→</span></a>
        <a class="inline-flex min-h-11 items-center border-2 border-crema-luminoso px-6 text-base font-semibold text-crema-luminoso no-underline hover:bg-crema-luminoso hover:text-verde-oscuro" href="#como-funciona">{t.hero.secondaryCta}</a>
      </div>
      <p class="mt-7 text-dato font-medium text-crema-luminoso opacity-85">{t.hero.segments}</p>
    </div>

    <!-- parallax collage -->
    <div class="relative h-[410px] min-w-0 flex-[1_1_300px]">
      <div class="parallax-a absolute top-0 right-0 flex h-[370px] w-[74%] flex-col justify-end overflow-clip bg-verde-principal p-4">
        <svg viewBox="0 0 300 80" preserveAspectRatio="none" aria-hidden="true" class="absolute top-[38%] left-0 h-20 w-full opacity-50"><polyline points="0,70 60,48 110,58 165,26 215,40 270,10 300,18" fill="none" stroke="#e0a632" stroke-width="3" vector-effect="non-scaling-stroke"></polyline></svg>
        <div class="absolute top-4 left-4 flex items-center gap-2.5 text-eyebrow font-semibold tracking-eyebrow-sm text-crema-luminoso uppercase">
          <span class="inline-flex size-9 items-center justify-center rounded-full border-2 border-crema-luminoso"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5 L13 8 L4 13.5 Z" fill="#fff7e8"></path></svg></span>
          {t.hero.videoLabel}
        </div>
        <p class="relative text-cuerpo text-crema-luminoso">{t.hero.videoNote}</p>
      </div>
      <div class="parallax-b absolute top-[200px] left-0 flex h-[165px] w-[44%] flex-col justify-end border-[6px] border-verde-oscuro bg-arena p-4 text-verde-oscuro">
        <p class="mb-1.5 text-eyebrow font-semibold tracking-eyebrow-sm text-verde-principal uppercase">{t.hero.photoLabel}</p>
        <p class="text-nota">{t.hero.photoNoteMain}</p>
      </div>
      <div class="parallax-c absolute top-7 left-[12%] flex h-[125px] w-[34%] flex-col justify-end border-[6px] border-verde-oscuro bg-mostaza-calido p-3.5 text-verde-oscuro">
        <p class="mb-1.5 text-eyebrow font-semibold tracking-eyebrow-sm uppercase">{t.hero.photoLabel}</p>
        <p class="text-nota">{t.hero.photoNoteSecondary}</p>
      </div>
    </div>
  </div>

  <!-- the path draws itself -->
  <svg viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true" class="absolute bottom-3 left-0 h-20 w-full">
    <polyline class="dibujar" pathLength="1" points="0,104 180,70 340,88 520,34 700,60 880,22 1060,50 1240,8 1440,30" fill="none" stroke="#e0a632" stroke-width="4" vector-effect="non-scaling-stroke"></polyline>
  </svg>
</section>
