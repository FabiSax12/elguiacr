---
import { getLocale, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';
import founder from '../assets/founder.jpeg';

const t = useTranslations(getLocale(Astro.currentLocale));
---

<section id="fundador" class="flex min-h-svh flex-col justify-center oscuro relative overflow-clip bg-verde-oscuro px-gutter py-seccion text-crema-luminoso">
  <div class="mx-auto w-full max-w-sitio">
    <h2 class="revelar max-w-[760px] font-titulos text-titulo-a font-bold">{t.founder.title}</h2>
    <div class="mt-8 h-px bg-mostaza-calido"></div>

    <div class="mt-9 flex flex-wrap items-center gap-x-18 gap-y-12">
      <figure class="min-w-0 flex-[1_1_420px]">
        <div class="flotar relative aspect-square overflow-clip rounded-imagen bg-verde-principal [--flotar-hover:0px]">
          <Image class="zoom-lento absolute inset-0 block size-full object-cover object-[68%_74%]" src={founder} widths={[500, 1000]} sizes="(min-width: 1000px) 560px, 100vw" alt={t.founder.photoAlt} quality={100}/>
        </div>
        <svg viewBox="0 0 400 40" preserveAspectRatio="none" aria-hidden="true" class="mt-4 block h-10 w-full"><polyline class="trazar" pathLength="1" points="0,34 70,18 130,26 200,6 260,16 330,2 400,10" fill="none" stroke="#e0a632" stroke-width="3" vector-effect="non-scaling-stroke"></polyline></svg>
      </figure>

      <div class="min-w-0 flex-[1_1_460px]">
        <div class="revelar flex items-baseline gap-[18px]">
          <!-- <span class="font-titulos text-[length:clamp(44px,4.7vw,64px)]/[0.9] font-extrabold text-mostaza-calido" aria-hidden="true">01</span> -->
          <span class="text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase">{t.founder.role}</span>
        </div>
        <h3 class="revelar mt-[18px] font-titulos text-[length:clamp(24px,2.4vw,32px)]/[1.05] font-bold">{t.founder.name}</h3>
        <div class="mt-6 flex flex-col gap-[18px] text-entrada/[1.65]">
          <p class="revelar">{t.founder.bio1}</p>
          <p class="revelar">{t.founder.bio2}</p>
        </div>
        <blockquote class="revelar mt-8 border-l-4 border-mostaza-calido pl-[22px]">
          <p class="font-titulos text-[length:clamp(18px,1.5vw,20px)]/[1.4] font-medium text-crema-luminoso italic">{t.founder.quote}</p>
        </blockquote>
        <a class="mt-9 inline-flex min-h-12 items-center gap-2.5 rounded-full bg-mostaza-calido px-[22px] text-subtitulo font-semibold text-verde-oscuro no-underline hover:bg-crema-luminoso hover:text-verde-oscuro" href="#contanos">{t.founder.cta} <span class="inline-block" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
