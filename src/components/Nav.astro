---
import { getRelativeLocaleUrl } from 'astro:i18n';
import logo from '../assets/logo.svg';
import { navLinks } from '../data/content';
import { localeMeta, locales } from '../i18n/config';
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const navLink = 'text-crema-luminoso no-underline hover:text-mostaza-calido';
---

<header class="oscuro relative z-50 border-b border-mostaza-calido/35 bg-verde-oscuro">
  <nav aria-label={t.nav.ariaLabel} class="mx-auto flex max-w-sitio flex-wrap items-center justify-between gap-x-7 gap-y-3 px-gutter py-3.5">
    <a href="#inicio" aria-label={t.nav.homeLabel} class="block leading-[0]"><img src={logo.src} alt="El Guía CR" width={logo.width} height={logo.height} class="block h-auto w-40" /></a>
    <div class="flex flex-wrap items-center gap-x-7 gap-y-2 text-subtitulo font-medium">
      {navLinks.map((link) => (
        <a class:list={[navLink, 'py-2.5']} href={link.href}>{t.nav.links[link.key]}</a>
      ))}
      <ul class="flex items-center" aria-label={t.nav.languageLabel}>
        {locales.map((code) => (
          <li class="not-first:before:text-crema-luminoso not-first:before:opacity-40 not-first:before:content-['|']">
            <a
              class:list={[navLink, 'inline-block min-w-11 py-2.5 text-center aria-[current=true]:font-bold aria-[current=true]:text-mostaza-calido']}
              href={getRelativeLocaleUrl(code)}
              lang={code}
              hreflang={code}
              aria-label={localeMeta[code].name}
              aria-current={code === locale ? 'true' : undefined}
            >{code.toUpperCase()}</a>
          </li>
        ))}
      </ul>
      <a class="inline-flex min-h-11 items-center bg-mostaza-calido px-5 text-subtitulo font-semibold text-verde-oscuro no-underline hover:bg-crema-luminoso hover:text-verde-oscuro" href="#contanos">{t.nav.cta}</a>
    </div>
  </nav>
</header>
