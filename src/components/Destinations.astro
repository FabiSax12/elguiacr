---
import { getLocale, useTranslations } from '../i18n/utils';
import { getImage } from 'astro:assets';
import CostaRicaMap from './CostaRicaMap.astro';
import { DEFAULT_SPOT_ID, getSpots } from '../data/spots';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const resolved = await Promise.all(
  getSpots(locale).map(async (spot) => {
    const { image, ...rest } = spot;
    const imageSrc = image ? (await getImage({ src: image, width: 1000 })).src : undefined;
    return { ...rest, imageSrc };
  }),
);
const initial = resolved.find((spot) => spot.id === DEFAULT_SPOT_ID) ?? resolved[0];
---

<section id="destinos" class="flex min-h-svh flex-col justify-center relative overflow-clip bg-arena px-gutter pt-seccion-alta pb-seccion-cierre">
  <div class="relative mx-auto w-full max-w-sitio">
    <div class="mx-auto w-full max-w-[780px] text-center">
      <p class="text-label font-semibold tracking-eyebrow text-verde-principal uppercase">{t.destinations.eyebrow}</p>
      <h2 class="mt-4 font-titulos text-titulo-a font-bold">{t.destinations.title}</h2>
      <p class="mx-auto mt-5 max-w-[580px] text-lg/[1.6]">{t.destinations.intro}</p>
    </div>

    <div class="mt-16 flex flex-wrap items-stretch gap-10">
      <!-- map -->
      <div class="min-w-0 flex-[1_1_560px]">
        <div class="relative aspect-[648.3/613] w-full">
          <CostaRicaMap />
          {resolved.map((spot) => (
            <button type="button" class="group absolute top-(--y) left-(--x) -mt-[22px] -ml-[22px] flex size-11 cursor-pointer items-center justify-center p-0" data-spot={spot.id} data-marker aria-label={spot.name} aria-pressed={String(spot.id === initial.id)} style={`--x: ${spot.x}%; --y: ${spot.y}%;`}>
              <span class="absolute hidden size-5 animate-pulso rounded-full bg-mostaza-calido group-aria-pressed:block" aria-hidden="true"></span>
              <span class="relative hidden size-[22px] rounded-full border-4 border-crema-luminoso bg-mostaza-calido group-aria-pressed:block" aria-hidden="true"></span>
              <span class="absolute bottom-10 left-1/2 hidden -translate-x-1/2 rounded-md bg-verde-oscuro px-2.5 py-1 text-dato font-semibold whitespace-nowrap text-crema-luminoso group-aria-pressed:block" aria-hidden="true">{spot.short}</span>
              <span class="size-3.5 rounded-full border-3 border-verde-oscuro bg-mostaza-calido group-aria-pressed:hidden" aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <!-- accessible / mobile list -->
        <div class="mt-5 flex flex-wrap gap-2">
          {resolved.map((spot) => (
            <button type="button" class="min-h-10 cursor-pointer rounded-full border-2 border-verde-oscuro bg-transparent px-3.5 text-dato font-medium text-verde-oscuro hover:bg-verde-oscuro hover:text-crema-luminoso aria-pressed:bg-verde-oscuro aria-pressed:text-crema-luminoso" data-spot={spot.id} aria-pressed={String(spot.id === initial.id)}>{spot.short}</button>
          ))}
        </div>
      </div>

      <!-- destination panel -->
      <aside class="flex min-w-0 flex-[1_1_360px] flex-col overflow-clip rounded-tarjeta bg-verde-oscuro text-crema-luminoso" aria-live="polite">
        <div class="relative h-[230px] overflow-clip bg-verde-principal">
          <img class="absolute inset-0 block size-full animate-foto-entra object-cover object-(--pos)" data-field="image" src={initial.imageSrc} alt={initial.alt} hidden={!initial.imageSrc} style={`--pos: ${initial.position ?? '50% 50%'};`} />
          <div data-field="placeholder" hidden={Boolean(initial.imageSrc)} class="absolute inset-0 flex items-end p-[18px]">
            <p data-field="photoNote" class="text-nota text-crema-luminoso">{initial.photoNote}</p>
          </div>
          <p data-field="credit" hidden={!initial.imageSrc || !initial.credit} class="absolute right-2 bottom-2 rounded-md bg-verde-oscuro/60 px-2 py-0.5 text-eyebrow text-crema-luminoso/85">
            {t.destinations.photoCredit}: <a data-field="creditAuthor" href={initial.credit?.photoUrl} class="text-crema-luminoso underline-offset-2 hover:underline" target="_blank" rel="noopener">{initial.credit?.author}</a> · <a data-field="creditLicense" href={initial.credit?.licenseUrl} class="text-crema-luminoso underline-offset-2 hover:underline" target="_blank" rel="noopener">{initial.credit?.license}</a>
          </p>
        </div>
        <div class="flex grow flex-col gap-3.5 px-7 pt-7 pb-8">
          <p data-field="region" class="text-label font-semibold tracking-eyebrow text-mostaza-calido uppercase">{initial.region}</p>
          <h3 data-field="name" class="font-titulos text-[26px]/[1.05] font-bold">{initial.name}</h3>
          <p data-field="desc" class="text-base/[1.6]">{initial.desc}</p>
          <p class="mt-1.5 text-dato font-medium text-mostaza-calido">{t.destinations.idealFor} <span data-field="idealLabel">{initial.idealLabel}</span></p>
          <a class="mt-auto inline-flex min-h-12 items-center gap-2.5 self-start rounded-full bg-mostaza-calido px-[22px] text-subtitulo font-semibold text-verde-oscuro no-underline hover:bg-crema-luminoso hover:text-verde-oscuro" href="#contanos" data-pick-destination>{t.destinations.pick} <span class="inline-block" aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
    <p class="mt-7 text-center text-cuerpo text-gris-texto">{t.destinations.footnote}</p>
  </div>
</section>

<script is:inline type="application/json" id="spots-data" set:html={JSON.stringify(resolved)} />

<script>
  interface ClientSpot {
    id: string;
    name: string;
    region: string;
    desc: string;
    idealLabel: string;
    photoNote: string;
    imageSrc?: string;
    alt?: string;
    position?: string;
    credit?: { author: string; photoUrl: string; license?: string; licenseUrl?: string };
  }

  const section = document.getElementById('destinos');
  const dataEl = document.getElementById('spots-data');

  if (section && dataEl?.textContent) {
    const spots: ClientSpot[] = JSON.parse(dataEl.textContent);
    const field = (name: string) => section.querySelector<HTMLElement>(`[data-field="${name}"]`);
    const image = field('image') as HTMLImageElement | null;
    const placeholder = field('placeholder');
    const credit = field('credit');
    const creditAuthor = field('creditAuthor') as HTMLAnchorElement | null;
    const creditLicense = field('creditLicense') as HTMLAnchorElement | null;
    let selectedId = section.querySelector<HTMLElement>('[data-marker][aria-pressed="true"]')?.dataset.spot;

    const select = (id: string) => {
      const spot = spots.find((candidate) => candidate.id === id);
      if (!spot || id === selectedId) return;
      selectedId = id;

      section.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
        el.setAttribute('aria-pressed', String(el.dataset.spot === id));
      });

      (['region', 'name', 'desc', 'idealLabel', 'photoNote'] as const).forEach((key) => {
        const el = field(key);
        if (el) el.textContent = spot[key];
      });

      if (image && placeholder) {
        image.hidden = !spot.imageSrc;
        placeholder.hidden = Boolean(spot.imageSrc);
        if (spot.imageSrc) {
          image.src = spot.imageSrc;
          image.alt = spot.alt ?? '';
          image.style.setProperty('--pos', spot.position ?? '50% 50%');
          // Replay the fade-in, as the original remounted the image on each change.
          image.classList.remove('animate-foto-entra');
          void image.offsetWidth;
          image.classList.add('animate-foto-entra');
        }
      }

      if (credit && creditAuthor && creditLicense) {
        credit.hidden = !spot.imageSrc || !spot.credit;
        if (spot.credit) {
          creditAuthor.href = spot.credit.photoUrl;
          creditAuthor.textContent = spot.credit.author;
          creditLicense.href = spot.credit.licenseUrl ?? '';
          creditLicense.textContent = spot.credit.license ?? '';
        }
      }
    };

    section.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
      el.addEventListener('click', () => select(el.dataset.spot ?? ''));
    });

    section.querySelector('[data-pick-destination]')?.addEventListener('click', () => {
      const spot = spots.find((candidate) => candidate.id === selectedId);
      if (!spot) return;
      document.dispatchEvent(new CustomEvent('destination-picked', { detail: { name: spot.name } }));
    });
  }
</script>
