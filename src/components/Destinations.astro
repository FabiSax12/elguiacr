---
import { getLocale, useTranslations } from '../i18n/utils';
import { getImage } from 'astro:assets';
import CostaRicaMap from './CostaRicaMap.astro';
import Leaves from './Leaves.astro';
import { DEFAULT_SPOT_ID, getSpots } from '../data/spots';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const resolved = await Promise.all(
  getSpots(locale).map(async (spot) => {
    const { image, ...rest } = spot;
    const imageSrc = image ? (await getImage({ src: image, width: 1000 })).src : undefined;
    return { ...rest, imageSrc };
  }),
);
const initial = resolved.find((spot) => spot.id === DEFAULT_SPOT_ID) ?? resolved[0];
---

<section id="destinos" style="position: relative; background: #f3ead8; overflow: clip; padding: clamp(96px, 12vw, 168px) clamp(16px, 5vw, 64px) clamp(80px, 10vw, 128px);">
  <Leaves backFill="#17362d" backVein="#e0a632" backInset="6%" backTop="50px" backWidth="38%" frontFill="#1f5c46" frontVein="#fff7e8" sideVeinOpacity=".5" />

  <div style="position: relative; max-width: 1240px; margin: 0 auto;">
    <div style="text-align: center; max-width: 780px; margin: 0 auto;">
      <p style="margin: 0; font: 600 12px/17px 'Source Sans 3', system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase; color: #1f5c46;">{t.destinations.eyebrow}</p>
      <h2 style="margin: 16px 0 0; font: 700 clamp(38px, 5vw, 68px)/1.04 'Alegreya', Georgia, serif;">{t.destinations.title}</h2>
      <p style="margin: 20px auto 0; max-width: 580px; font: 400 18px/1.6 'Source Sans 3', system-ui, sans-serif;">{t.destinations.intro}</p>
    </div>

    <div style="margin-top: 64px; display: flex; flex-wrap: wrap; gap: 40px; align-items: stretch;">
      <!-- map -->
      <div style="flex: 1 1 560px; min-width: 0;">
        <div style="position: relative; width: 100%; aspect-ratio: 648.3 / 613;">
          <CostaRicaMap />
          {resolved.map((spot) => (
            <button type="button" class="marker" data-spot={spot.id} aria-label={spot.name} aria-pressed={String(spot.id === initial.id)} style={`position: absolute; left: ${spot.x}%; top: ${spot.y}%; width: 44px; height: 44px; margin: -22px 0 0 -22px; padding: 0; border: 0; background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center;`}>
              <span class="pulso on" aria-hidden="true" style="position: absolute; width: 20px; height: 20px; border-radius: 50%; background: #e0a632;"></span>
              <span class="on" aria-hidden="true" style="position: relative; width: 22px; height: 22px; border-radius: 50%; background: #e0a632; border: 4px solid #fff7e8; box-sizing: border-box;"></span>
              <span class="on" aria-hidden="true" style="position: absolute; left: 50%; bottom: 40px; transform: translateX(-50%); white-space: nowrap; background: #17362d; color: #fff7e8; padding: 4px 10px; font: 600 13px/20px 'Source Sans 3', system-ui, sans-serif;">{spot.short}</span>
              <span class="off" aria-hidden="true" style="width: 14px; height: 14px; border-radius: 50%; background: #e0a632; border: 3px solid #17362d; box-sizing: border-box;"></span>
            </button>
          ))}
        </div>
        <!-- accessible / mobile list -->
        <div style="margin-top: 20px; display: flex; flex-wrap: wrap; gap: 8px;">
          {resolved.map((spot) => (
            <button type="button" class="chip chip-destino" data-spot={spot.id} aria-pressed={String(spot.id === initial.id)}>{spot.short}</button>
          ))}
        </div>
      </div>

      <!-- destination panel -->
      <aside class="ficha" aria-live="polite" style="flex: 1 1 360px; min-width: 0; background: #17362d; color: #fff7e8; display: flex; flex-direction: column;">
        <div style="height: 340px; background: #1f5c46; overflow: clip; position: relative;">
          <img class="foto-destino" data-field="image" src={initial.imageSrc} alt={initial.alt} hidden={!initial.imageSrc} style={`position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: ${initial.position ?? '50% 50%'}; display: block;`} />
          <div data-field="placeholder" hidden={Boolean(initial.imageSrc)} style="position: absolute; inset: 0; display: flex; align-items: flex-end; padding: 18px;">
            <p data-field="photoNote" style="margin: 0; font: 400 13px/19px 'Source Sans 3', system-ui, sans-serif; color: #fff7e8;">{initial.photoNote}</p>
          </div>
        </div>
        <div style="padding: 28px 28px 32px; display: flex; flex-direction: column; gap: 14px; flex-grow: 1;">
          <p data-field="region" style="margin: 0; font: 600 12px/17px 'Source Sans 3', system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase; color: #e0a632;">{initial.region}</p>
          <h3 data-field="name" style="margin: 0; font: 700 38px/1.05 'Alegreya', Georgia, serif;">{initial.name}</h3>
          <p data-field="desc" style="margin: 0; font: 400 16px/1.6 'Source Sans 3', system-ui, sans-serif;">{initial.desc}</p>
          <p style="margin: 6px 0 0; font: 500 13px/20px 'Source Sans 3', system-ui, sans-serif; color: #e0a632;">{t.destinations.idealFor} <span data-field="idealLabel">{initial.idealLabel}</span></p>
          <a class="btn-claro" href="#contanos" data-pick-destination style="margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; background: #e0a632; color: #17362d; font: 600 15px/24px 'Source Sans 3', system-ui, sans-serif; text-decoration: none;">{t.destinations.pick} <span class="flecha" aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
    <p style="margin: 28px 0 0; font: 400 14px/21px 'Source Sans 3', system-ui, sans-serif; color: #5b625f; text-align: center;">{t.destinations.footnote}</p>
  </div>
</section>

<script is:inline type="application/json" id="spots-data" set:html={JSON.stringify(resolved)} />

<style>
  [hidden] {
    display: none !important;
  }
  .marker[aria-pressed='true'] .off,
  .marker[aria-pressed='false'] .on {
    display: none;
  }
  .chip {
    min-height: 40px;
    padding: 0 14px;
    border: 2px solid #17362d;
    background: transparent;
    color: #17362d;
    font: 500 13px/20px 'Source Sans 3', system-ui, sans-serif;
    cursor: pointer;
  }
  .chip[aria-pressed='true'] {
    background: #17362d;
    color: #fff7e8;
  }
</style>

<script>
  interface ClientSpot {
    id: string;
    name: string;
    region: string;
    desc: string;
    idealLabel: string;
    photoNote: string;
    imageSrc?: string;
    alt?: string;
    position?: string;
  }

  const section = document.getElementById('destinos');
  const dataEl = document.getElementById('spots-data');

  if (section && dataEl?.textContent) {
    const spots: ClientSpot[] = JSON.parse(dataEl.textContent);
    const field = (name: string) => section.querySelector<HTMLElement>(`[data-field="${name}"]`);
    const image = field('image') as HTMLImageElement | null;
    const placeholder = field('placeholder');
    let selectedId = section.querySelector<HTMLElement>('.marker[aria-pressed="true"]')?.dataset.spot;

    const select = (id: string) => {
      const spot = spots.find((candidate) => candidate.id === id);
      if (!spot || id === selectedId) return;
      selectedId = id;

      section.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
        el.setAttribute('aria-pressed', String(el.dataset.spot === id));
      });

      (['region', 'name', 'desc', 'idealLabel', 'photoNote'] as const).forEach((key) => {
        const el = field(key);
        if (el) el.textContent = spot[key];
      });

      if (image && placeholder) {
        image.hidden = !spot.imageSrc;
        placeholder.hidden = Boolean(spot.imageSrc);
        if (spot.imageSrc) {
          image.src = spot.imageSrc;
          image.alt = spot.alt ?? '';
          image.style.objectPosition = spot.position ?? '50% 50%';
          // Replay the fade-in, as the original remounted the image on each change.
          image.classList.remove('foto-destino');
          void image.offsetWidth;
          image.classList.add('foto-destino');
        }
      }
    };

    section.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
      el.addEventListener('click', () => select(el.dataset.spot ?? ''));
    });

    section.querySelector('[data-pick-destination]')?.addEventListener('click', () => {
      const spot = spots.find((candidate) => candidate.id === selectedId);
      if (!spot) return;
      document.dispatchEvent(new CustomEvent('destination-picked', { detail: { name: spot.name } }));
    });
  }
</script>
