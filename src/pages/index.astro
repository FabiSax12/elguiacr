---
import Audiences from '../components/Audiences.astro';
import ContactForm from '../components/ContactForm.astro';
import Destinations from '../components/Destinations.astro';
import Footer from '../components/Footer.astro';
import Founder from '../components/Founder.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Manifesto from '../components/Manifesto.astro';
import Nav from '../components/Nav.astro';
import Stories from '../components/Stories.astro';
import Ticker from '../components/Ticker.astro';
import Values from '../components/Values.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="landing" style="width: 100%; min-width: 320px; background: #fff7e8; color: #17362d; font-family: 'Source Sans 3', 'Segoe UI', system-ui, sans-serif; overflow-x: clip;">
    <Nav />
    <Hero />
    <Ticker />
    <Manifesto />
    <Audiences />
    <HowItWorks />
    <Founder />
    <Destinations />
    <Stories />
    <Values />
    <ContactForm />
    <Footer />
  </div>
</Layout>
