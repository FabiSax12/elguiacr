---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'El Guía CR · Experiencias diseñadas con propósito',
  description = 'elguiacr.com · Diseño y coordinación de experiencias en Costa Rica. Viajeros, locales, empresas y educación.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..900;1,400..900&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
